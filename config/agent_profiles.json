{
  "agents": {
    "soc1_triage_agent": {
      "name": "SOC1 Triage Agent",
      "tier": "soc1",
      "description": "Handles initial alert triage and false positive identification",
      "capabilities": [
        "initial_triage",
        "basic_enrichment",
        "false_positive_identification",
        "netbox_infra_lookup"
      ],
      "runbooks": [
        "soc1/triage/initial_alert_triage",
        "soc1/enrichment/ioc_enrichment",
        "soc1/remediation/close_false_positive"
      ],
      "case_runbooks": [
        "soc1/cases/suspicious_login_triage",
        "soc1/cases/malware_initial_triage"
      ],
      "tools": [
        "create_case",
        "review_case",
        "list_cases",
        "search_cases",
        "update_case",
        "add_case_comment",
        "attach_observable_to_case",
        "update_case_status",
        "assign_case",
        "get_case_timeline",
        "add_case_task",
        "list_case_tasks",
        "get_security_alerts",
        "get_security_alert_by_id",
        "get_siem_event_by_id",
        "lookup_entity",
        "get_ioc_matches",
        "get_file_report",
        "get_ip_address_report",
        "search_security_events",
        "lookup_hash_ti",
        "get_network_events",
        "get_dns_events",
        "get_alerts_by_entity",
        "get_alerts_by_time_window",
        "get_email_events",
        "netbox_lookup_ip",
        "netbox_lookup_host",
        "netbox_lookup_prefix",
        "netbox_search",
        "create_fine_tuning_recommendation",
        "create_visibility_recommendation",
        "list_fine_tuning_recommendations",
        "list_visibility_recommendations",
        "add_comment_to_fine_tuning_recommendation",
        "add_comment_to_visibility_recommendation"
      ],
      "decision_authority": {
        "close_false_positives": true,
        "close_benign_true_positives": true,
        "escalate_to_soc2": true,
        "escalate_to_soc3": false,
        "containment_actions": false,
        "forensic_collection": false
      },
      "auto_select_runbook": true,
      "max_concurrent_cases": 10
    }
  },
  "routing_rules": {
    "new_alert": "soc1_triage_agent",
    "review_cases": "soc1_triage_agent"
  }
}
